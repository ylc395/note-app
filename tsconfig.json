{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "ESNext",
    "incremental": true,
    "types": [],
    "lib": ["ESNext"],
    "sourceMap": true,
    "importHelpers": true,
    "allowJs": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "skipLibCheck": true,
    "paths": {
      "#domain/*": ["./src/domain/*"],
      "#utils/*": ["./src/utils/*"],
      "#api/*": ["./src/driver/server/api/*"],
      "#web/*": ["./src/driver/client/web/*"]
    }
  }
}
