{
  "compilerOptions": {
    "target": "ES2023", // 用了 ES Decorator，如果编译到 ESNext，各个 runtime 还不支持
    "allowJs": true,
    "types": [],
    "outDir": "./dist",
    "lib": ["ESNext"],
    "sourceMap": true,
    "importHelpers": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "paths": {
      "#domain/*": ["./src/domain/*"],
      "#third-party/*": ["./src/third-party/*"],
      "#utils/*": ["./src/utils/*"],
      "#api/*": ["./src/driver/server/api/*"],
      "#web/*": ["./src/driver/client/web/*"]
    }
  }
}
